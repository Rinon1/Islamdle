# Cloudflare Pages headers.
# CSS and JS are referenced with a ?v= content hash by tools/build_dist.py,
# so they can be cached hard: a change produces a new URL.
/css/*
  Cache-Control: public, max-age=31536000, immutable
/js/*
  Cache-Control: public, max-age=31536000, immutable

# The puzzle data and the pages themselves must always revalidate, otherwise
# a player can be served yesterday's build after a content update.
/data/*
  Cache-Control: public, max-age=0, must-revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/
  Cache-Control: public, max-age=0, must-revalidate

# Baseline security headers for a static site with no login and no forms.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
